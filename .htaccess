
RewriteEngine on

# --- Canonical host: one 301 hop to https://www.pleasureislanddesign.com ---
# 1) http://(www.)pleasureislanddesign.com/* -> https://www...
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^pleasureislanddesign\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.pleasureislanddesign\.com$ [NC]
RewriteRule ^(.*)$ "https\:\/\/www\.pleasureislanddesign\.com\/$1" [R=301,L]

# 2) https://pleasureislanddesign.com/* (bare domain over HTTPS) -> https://www...
RewriteCond %{HTTP_HOST} ^pleasureislanddesign\.com$ [NC]
RewriteRule ^(.*)$ "https\:\/\/www\.pleasureislanddesign\.com\/$1" [R=301,L]

RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http://pleasureislanddesign.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://pleasureislanddesign.com$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.pleasureislanddesign.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.pleasureislanddesign.com$      [NC]
RewriteCond %{HTTP_REFERER} !^https://pleasureislanddesign.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://pleasureislanddesign.com$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.pleasureislanddesign.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.pleasureislanddesign.com$      [NC]
RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]

# --- Protect sensitive runtime data (PII: leads, subscribers, logs, backups) ---
# .data/ and .logs/ hold form submissions and subscriber records written by the
# PHP handlers. They live under the web root, so block all direct HTTP access.
RedirectMatch 404 ^/\.(data|logs|backups)(/|$)

# Blog automation is CLI-only and is no longer deployed (lives in blog-automation/,
# outside the web root). These rules also cover any copies still sitting on the
# server from older uploads: drafts, the publisher script and its schedule file.
RedirectMatch 404 ^/blog/drafts(/|$)
RedirectMatch 404 ^/blog/(publish-scheduled\.php|scheduled-posts\.json)$
RedirectMatch 404 ^/blog-automation(/|$)
RedirectMatch 404 ^/forms/lib(/|$)

# Defense-in-depth: never serve raw data/config file types even if path-guessed.
<FilesMatch "\.(jsonl|log|bak|tmp)$">
  Require all denied
</FilesMatch>

# --- Performance: compression + browser caching (no-ops if modules are absent) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>
